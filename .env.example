# Endpoint que recibe el formulario de contacto.
# Formspree:  https://formspree.io/f/xxxxxxx
# Getform:    https://getform.io/f/xxxxxxx
# API propia: https://api.argos.uy/leads
# Si queda vacio, el formulario valida y muestra el exito sin enviar nada (modo demo).
VITE_LEADS_ENDPOINT=

# Telefono de WhatsApp en formato internacional sin +, ni espacios.
VITE_WHATSAPP=59899000000

# Mail de contacto que se muestra en el pie.
VITE_CONTACT_EMAIL=hola@argos.uy
